# 키 이름만 기재. 값은 .env.local에 (커밋 금지). service_role 키는 웹에 두지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 사이트 주소: 재설정 링크·Origin 검사의 기준(공개 값, 배포 도메인으로 교체)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 서버 전용 비밀(NEXT_PUBLIC_ 금지): 요청 한도 키를 비식별화한다. 32자 이상 무작위 값
AUTH_RATE_LIMIT_SECRET=

# 유튜브 수집(task-027b). 기본 꺼짐. 운영에서 켜면 YOUTUBE_METADATA_PROVIDER=youtube와 키가 필수
YOUTUBE_ENABLED=
YOUTUBE_METADATA_PROVIDER=
YOUTUBE_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 스텁 공급자 허용(로컬·테스트만 1). 없으면 플래그를 켰을 때 스텁은 503
YOUTUBE_ALLOW_STUB=
