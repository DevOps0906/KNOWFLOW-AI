erDiagram
    ocr_documents {
        uuid id PK
        uuid org_id FK
        uuid doc_type_id FK
        uuid file_id "files-storage 참조"
        int doc_type_version "처리 시점 버전 고정"
        text status "queued processing needs_review confirmed rejected failed"
        int page_count
        int version "낙관적 잠금"
        text sha256 "같은 org 중복 안내만"
        text uploaded_by "개인정보★"
    }
    ocr_doc_types {
        uuid id PK
        uuid org_id FK "null이면 플랫폼 기본"
        text code "org_id와 버전과 함께 유니크"
        text name
        int schema_version
        json schema "필드 키 라벨 형식 필수"
        json validation_rules
        text status "active disabled"
    }
    ocr_pages {
        uuid id PK
        uuid org_id FK
        uuid document_id FK
        int page_no "document_id와 함께 유니크"
        uuid image_file_id "files-storage 참조"
        int rotation "회전 각도"
        json words "텍스트 좌표 신뢰도, 마스킹 후 저장"
    }
    ocr_fields {
        uuid id PK
        uuid org_id FK
        uuid document_id FK
        text key "document_id와 함께 유니크"
        text value "개인정보★ 마스킹 후 저장"
        float confidence "0~1"
        text source "rule llm manual"
        text validation "ok invalid 미검증"
        text previous_value "수정 전 값 개인정보★"
        uuid edited_by
    }
    ocr_jobs {
        uuid id PK
        uuid org_id FK
        text kind "ocr"
        text status "queued running succeeded failed cancelled"
        int progress "0~100"
        int attempts "max_attempts 3"
        text idempotency_key "org_id와 함께 유니크"
        text input_ref "file_id 참조"
        text output_ref "document_id, FK 없음"
    }
    ocr_outbox_events {
        uuid id PK "event_id"
        uuid org_id FK
        text type "ocr.document.confirmed"
        text aggregate_type "ocr_document"
        text aggregate_id "문서 id"
        bigint sequence "집계별 단조 증가"
        text result "성공 실패"
        timestamptz occurred_at
    }

    ocr_doc_types ||--o{ ocr_documents : "종류 1 : 문서 N"
    ocr_documents ||--o{ ocr_pages : "문서 1 : 페이지 N"
    ocr_documents ||--o{ ocr_fields : "문서 1 : 필드 N"
